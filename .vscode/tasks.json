{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Schedule + Google Calendar",
      "type": "process",
      "command": "node",
      "args": ["server/index.mjs"],
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    },
    {
      "label": "预览网页",
      "type": "process",
      "command": "python",
      "args": ["-m", "http.server", "5500", "--bind", "127.0.0.1"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}
