# Copy to server/.env. Never commit credentials.
PORT=8787
# Codex uses the local CLI's saved login. Run `codex login` once if needed.
# Optional executable path (native .exe or the npm package's bin/codex.js).
# FORGEOS_CODEX_BIN=C:/Users/YOUR_USER/AppData/Local/Programs/OpenAI/Codex/bin/codex.exe
# Optional model available to your Codex account; empty uses the CLI default.
# FORGEOS_CODEX_MODEL=
# auto follows existing proxy environment / Windows system settings for Codex.
# Use direct only if your network can already reach OpenAI without a proxy.
FORGEOS_CODEX_PROXY_URL=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register this exact URI on a Google Web application OAuth client.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/calendar/oauth/callback
# auto: follow existing proxy environment variables or Windows system proxy settings.
# No startup probes, listener enumeration or VPN configuration changes.
# direct: use the system network (including an active VPN TUN route).
GOOGLE_PROXY_URL=auto
# Or explicitly set your trusted HTTP / Mixed proxy:
# GOOGLE_PROXY_URL=http://127.0.0.1:7890
# Enable the standard Google Calendar API. A personal Google account works.
# Use a regular Web application OAuth client, External audience, your test email.
# No Workspace subscription or MCP developer preview enrollment is required.
# Event request records default to ~/.forgeos/calendar, outside the website.
# FORGEOS_DATA_DIR=C:/Users/YOUR_USER/.forgeos/calendar
